# Database (Postgres — e.g. Vercel Postgres/Neon, Supabase, or local Postgres for dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qrcertificate"

# Auth
# 64+ char random secret used to sign admin session JWTs. Generate with:
#   openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-value"

# Certificate integrity
# Secret salt mixed into every certificate verification hash (SHA-256).
# Never reuse across environments; never commit the real value.
CERT_HASH_SECRET="change-me-to-a-long-random-value"

# Public base URL used to build the QR verification link
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Bootstrap super admin (only used by prisma/seed.ts, first run)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe!12345"

# File uploads (trainer signatures, template backgrounds)
# Required in production/serverless (e.g. Vercel) — the local filesystem
# doesn't persist between requests there. Vercel auto-injects this when you
# enable Blob storage for the project (Storage tab -> Create -> Blob).
# Leave unset for local dev to fall back to writing under public/uploads/.
BLOB_READ_WRITE_TOKEN=""
